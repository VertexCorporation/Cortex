<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Search / Ask Bar -->
    <LinearLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/widget_input_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_title"
            android:src="@drawable/ic_widget_sparkle" />

        <TextView
            android:id="@+id/widget_prompt_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_ask_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/widget_voice_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_voice_desc"
            android:padding="6dp"
            android:src="@drawable/ic_widget_mic" />
    </LinearLayout>

    <!-- Optional Recent Answer Preview (visible when expanded or when a recent answer exists) -->
    <LinearLayout
        android:id="@+id/widget_last_qa_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_last_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_last_answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
